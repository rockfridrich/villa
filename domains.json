{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Villa domain configuration - managed in repo, DNS in CloudFlare",
  "domains": {
    "production": {
      "domain": "villa.cash",
      "alias": ["www.villa.cash"],
      "provider": "railway",
      "railwayService": "villa-production",
      "railwayTarget": "villa-staging-production.up.railway.app",
      "dns": "cloudflare",
      "deployTrigger": "push-to-main",
      "description": "Production hub on Railway"
    },
    "key-production": {
      "domain": "key.villa.cash",
      "provider": "railway",
      "railwayService": "villa-key",
      "railwayTarget": "villa-key-staging-production.up.railway.app",
      "dns": "cloudflare",
      "deployTrigger": "push-to-main",
      "description": "Production passkey domain"
    },
    "construction": {
      "domain": "construction.villa.cash",
      "provider": "railway",
      "railwayService": "villa-production",
      "railwayTarget": "villa-staging-production.up.railway.app",
      "dns": "cloudflare",
      "deployTrigger": "push-to-main",
      "description": "Staging/construction zone"
    },
    "fake-key": {
      "domain": "fake-key.villa.cash",
      "provider": "railway",
      "railwayService": "villa-key",
      "railwayTarget": "villa-key-staging-production.up.railway.app",
      "dns": "cloudflare",
      "deployTrigger": "push-to-main",
      "description": "Test passkeys for community"
    },
    "docs": {
      "domain": "docs.villa.cash",
      "provider": "railway",
      "railwayService": "villa-developers",
      "railwayTarget": "villa-developers-production.up.railway.app",
      "dns": "cloudflare",
      "deployTrigger": "push-to-main",
      "description": "Developer documentation portal"
    }
  },
  "railway": {
    "projectId": "7c344004-cd63-4b10-8479-9991c3923115",
    "environmentId": "00c94bb8-6243-44b5-b230-a2e957b1d0fb",
    "services": {
      "villa-production": "1c25828b-4678-4723-8cb5-8777312584a8",
      "villa-key": "2b3dab1c-0b03-41c4-b9f3-429579532a72",
      "villa-developers": "afc99a53-eb94-45ff-b018-8fc29b8cc84a",
      "postgres": "360242c6-e2d4-42e2-b377-c4f9cf283bff"
    }
  },
  "environments": {
    "production": {
      "chain": "base-sepolia",
      "chainId": 84532,
      "portoEnv": "stg",
      "domains": ["villa.cash", "key.villa.cash", "construction.villa.cash", "fake-key.villa.cash", "docs.villa.cash"]
    }
  },
  "ithaca": {
    "note": "These domains must be registered with Ithaca/Porto for passkey support",
    "registeredDomains": [
      "villa.cash",
      "key.villa.cash",
      "construction.villa.cash",
      "fake-key.villa.cash",
      "docs.villa.cash"
    ]
  }
}
