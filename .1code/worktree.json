{
  "setup-worktree": [
    "bun install",
    "cp $ROOT_WORKTREE_PATH/.env .env",
    "cp $ROOT_WORKTREE_PATH/.env.local .env.local",
    "cp $ROOT_WORKTREE_PATH/.env.docker .env.docker",
    "cp $ROOT_WORKTREE_PATH/apps/hub/.env apps/hub/.env",
    "cp $ROOT_WORKTREE_PATH/apps/hub/.env.local apps/hub/.env.local",
    "git config core.hooksPath .githooks"
  ]
}
