{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-20250514",
  "small_model": "anthropic/claude-3-5-haiku-20241022",
  "autoupdate": true,
  "instructions": [".opencode/BOOT.md", "CLAUDE.md"],
  "agent": {
    "explore": {
      "description": "Fast codebase search. Read-only.",
      "mode": "subagent",
      "model": "google/gemini-2.5-flash",
      "maxSteps": 20,
      "tools": {
        "Read": true,
        "Grep": true,
        "Glob": true,
        "Write": false,
        "Edit": false,
        "Bash": false
      }
    },
    "build": {
      "description": "Implement features and fix bugs. Full code access.",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-20250514",
      "maxSteps": 50,
      "tools": {
        "Read": true,
        "Write": true,
        "Edit": true,
        "Bash": true,
        "Grep": true,
        "Glob": true
      }
    },
    "fix": {
      "description": "Quick fixes, ≤3 files. Cheap and fast.",
      "mode": "subagent",
      "model": "anthropic/claude-3-5-haiku-20241022",
      "maxSteps": 15,
      "tools": {
        "Read": true,
        "Write": true,
        "Edit": true,
        "Bash": true,
        "Grep": true,
        "Glob": true
      }
    },
    "test": {
      "description": "Run tests and report results. No code changes.",
      "mode": "subagent",
      "model": "anthropic/claude-3-5-haiku-20241022",
      "maxSteps": 10,
      "tools": {
        "Bash": true,
        "Read": true,
        "Grep": true,
        "Glob": true,
        "Write": false,
        "Edit": false
      }
    },
    "review": {
      "description": "Code review for quality, security, spec compliance.",
      "mode": "subagent",
      "model": "google/gemini-2.5-pro",
      "maxSteps": 15,
      "tools": {
        "Read": true,
        "Grep": true,
        "Glob": true,
        "Bash": true,
        "Write": false,
        "Edit": false
      }
    }
  },
  "permission": {
    "bash": { "*": "allow" },
    "edit": "allow",
    "write": "allow"
  }
}
