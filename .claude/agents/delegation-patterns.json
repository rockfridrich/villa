{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Delegation patterns for cost-optimized agent routing",
  "version": "2.0.0",
  "patterns": [
    {
      "id": "file-search",
      "trigger": ["Grep", "Glob", "find", "search", "where is"],
      "delegate": "@explore",
      "model": "gemini-2.5-flash",
      "cost_ratio": "40x cheaper than Sonnet 4.5",
      "confidence": "high",
      "example": "Find all files using the Porto SDK"
    },
    {
      "id": "multi-read",
      "trigger": ["3+ Read calls", "read multiple files"],
      "delegate": "@explore",
      "model": "gemini-2.5-flash",
      "cost_ratio": "40x cheaper than Sonnet 4.5",
      "confidence": "high",
      "example": "Read all config files to understand the setup"
    },
    {
      "id": "test-execution",
      "trigger": ["test", "playwright", "vitest", "bun test", "bun verify"],
      "delegate": "@test",
      "model": "haiku-3.5",
      "cost_ratio": "12x cheaper than Sonnet 4.5",
      "confidence": "high",
      "example": "Run the E2E tests for authentication"
    },
    {
      "id": "quick-fix",
      "trigger": ["fix typo", "type error", "lint error", "small bug"],
      "delegate": "@fix",
      "model": "haiku-3.5",
      "cost_ratio": "12x cheaper than Sonnet 4.5",
      "confidence": "high",
      "example": "Fix the type error in Button.tsx"
    },
    {
      "id": "implementation",
      "trigger": ["implement", "build", "create component", "write code", "refactor"],
      "delegate": "@build",
      "model": "sonnet-4.5",
      "cost_ratio": "5x cheaper than Opus",
      "confidence": "high",
      "example": "Implement the login form component"
    },
    {
      "id": "code-review",
      "trigger": ["review", "PR review", "check code", "security audit"],
      "delegate": "@review",
      "model": "gemini-2.5-pro",
      "cost_ratio": "5x cheaper than Opus",
      "confidence": "high",
      "example": "Review the changes in this PR"
    }
  ],
  "metrics": {
    "target_delegation_rate": 0.8,
    "alert_threshold": 0.5
  },
  "overrides": {
    "always_claude_code": [
      "Architecture decisions",
      "Cross-service changes",
      "SDK modifications",
      "Security-critical code",
      "Agent prompt creation"
    ]
  }
}
