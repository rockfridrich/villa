# Villa Telemetry (local development only — NOT deployed)
# Internal monitoring dashboard
# Copy to .env.local for local development (gitignored)

# Paths (adjust to your machine)
VILLA_ROOT=/path/to/villa
BACKUP_DIR=/path/to/backups

# Database (for monitoring — same as hub DATABASE_URL)
# DATABASE_URL=postgresql://villa:villa_dev_password@localhost:5432/villa_dev

# Cloudflare (for CDN monitoring)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# Testing
BASE_URL=http://localhost:3003
# CI=false

# Requires: gh auth login (GitHub CLI)
