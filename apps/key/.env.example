# Villa Key Service (key.villa.cash)
# Passkey authentication domain — WebAuthn isolation
# Copy to .env.local for local development (gitignored)

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3001
NODE_ENV=development

# Hub API (where profiles and nicknames live)
NEXT_PUBLIC_HUB_API_URL=http://localhost:3000

# Blockchain
NEXT_PUBLIC_CHAIN_ID=84532

# Build Info (set by CI/Railway — do not set locally)
# NEXT_PUBLIC_VERSION=
# NEXT_PUBLIC_GIT_SHA=
# NEXT_PUBLIC_BUILD_TIME=
# NEXT_PUBLIC_ENV=development

# Cache Revalidation (optional, server-side only)
# REVALIDATE_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
