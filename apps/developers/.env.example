# Villa Developers Portal (docs.villa.cash)
# SDK documentation and playground
# Copy to .env.local for local development (gitignored)

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3002
NODE_ENV=development

# Build Info (set by CI/Railway — do not set locally)
# NEXT_PUBLIC_VERSION=
# NEXT_PUBLIC_GIT_SHA=
# NEXT_PUBLIC_BUILD_TIME=
# NEXT_PUBLIC_ENV=development

# Cache Revalidation (optional, server-side only)
# REVALIDATE_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
